{
  "name": "@foliwake/server",
  "version": "0.10.0",
  "description": "Server toolkit for apps that show Foliwake pages: config v2, origin client, envelope read, page check and preparation, code/media proxy handlers, CSP. Web Request/Response, no framework.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.22" },
  "repository": { "type": "git", "url": "git+https://github.com/foliwake/foliwake-js.git", "directory": "packages/server" },
  "homepage": "https://sdk.foliwake.dev/reference/packages/server",
  "bugs": { "url": "https://github.com/foliwake/foliwake-js/issues" },
  "keywords": ["foliwake", "cms", "headless", "blocks", "server", "csp", "fetch"],
  "publishConfig": { "access": "public", "provenance": true },
  "foliwake": { "plain": 2, "blocksContract": 2, "remoteConfig": 3, "discovery": 1 },
  "exports": {
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
    "./origin": { "types": "./dist/origin.d.ts", "default": "./dist/origin.js" },
    "./page": { "types": "./dist/page.d.ts", "default": "./dist/page.js" },
    "./handlers": { "types": "./dist/handlers.d.ts", "default": "./dist/handlers.js" },
    "./html": { "types": "./dist/html.d.ts", "default": "./dist/html.js" },
    "./csp": { "types": "./dist/csp.d.ts", "default": "./dist/csp.js" },
    "./preload": { "types": "./dist/preload.d.ts", "default": "./dist/preload.js" },
    "./hook": { "types": "./dist/hook.d.ts", "default": "./dist/hook.js" },
    "./handler": { "types": "./dist/handler.d.ts", "default": "./dist/handler.js" },
    "./hook-endpoint": { "types": "./dist/hook-endpoint.d.ts", "default": "./dist/hook-endpoint.js" },
    "./discovery": { "types": "./dist/discovery.d.ts", "default": "./dist/discovery.js" },
    "./resolve": { "types": "./dist/resolve.d.ts", "default": "./dist/resolve.js" },
    "./schemas/remote-2.schema.json": "./schemas/remote-2.schema.json",
    "./schemas/remote-3.schema.json": "./schemas/remote-3.schema.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@foliwake/blocks-contract": "workspace:*",
    "htmlparser2": "10.1.0",
    "jose": "6.2.15"
  },
  "files": ["dist/", "!dist/**/*.map", "!dist/.build-stamp", "!dist/.build-manifest.json", "schemas/", "LICENSE", "README.md", "CHANGELOG.md"]
}
