{
  "name": "@foliwake/block-kit",
  "version": "0.4.0",
  "description": "The block kit of Foliwake site blocks, the module `@foliwake/block-kit` (defineBlock, html, readFields), with its types and the blocks contract's: one package for block authors. The browser files the engine adds to every code release.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.22" },
  "repository": { "type": "git", "url": "git+https://github.com/foliwake/foliwake-js.git", "directory": "packages/block-kit" },
  "homepage": "https://docs.foliwake.dev/reference/packages/block-kit",
  "bugs": { "url": "https://github.com/foliwake/foliwake-js/issues" },
  "keywords": ["foliwake", "cms", "blocks", "web-components", "lit-html", "types"],
  "publishConfig": { "access": "public", "provenance": true },
  "foliwake": { "blocksContract": 2 },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/block-kit.js" },
    "./assessment": { "types": "./dist/assessment.d.ts", "default": "./dist/assessment.js" },
    "./block-kit.js": "./dist/block-kit.js",
    "./lit-html.js": "./dist/lit-html.js",
    "./lit-html.LICENSE": "./dist/lit-html.LICENSE",
    "./foliwake.d.ts": "./dist/foliwake.d.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@foliwake/blocks-contract": "workspace:*"
  },
  "files": ["dist/", "!dist/**/*.map", "LICENSE", "README.md", "CHANGELOG.md"]
}
