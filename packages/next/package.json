{
  "name": "@foliwake/next",
  "version": "0.3.0",
  "description": "Next.js App Router adapter for Foliwake pages: withFoliwake, cached envelope read, <FoliwakeServerPage>, preview pages, code and media route handlers, CSP header.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/foliwake/foliwake-js.git", "directory": "packages/next" },
  "homepage": "https://sdk.foliwake.dev/reference/packages/next",
  "bugs": { "url": "https://github.com/foliwake/foliwake-js/issues" },
  "keywords": ["foliwake", "cms", "headless", "blocks", "nextjs", "next", "react", "app-router"],
  "engines": { "node": ">=22.22" },
  "publishConfig": { "access": "public", "provenance": true },
  "foliwake": { "plain": 2, "blocksContract": 2, "remoteConfig": 2 },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
    "./routes": { "types": "./dist/routes.d.ts", "default": "./dist/routes.js" },
    "./cache": { "types": "./dist/cache.d.ts", "default": "./dist/cache.js" },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@foliwake/blocks-contract": "workspace:*",
    "@foliwake/react": "workspace:*",
    "@foliwake/server": "workspace:*",
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "next": ">=16.2.0 <17",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "next": "16.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "files": ["dist/", "!dist/**/*.map", "!dist/.build-stamp", "!dist/.build-manifest.json", "LICENSE", "README.md", "CHANGELOG.md"]
}
