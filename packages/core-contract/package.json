{
  "name": "@foliwake/core-contract",
  "version": "0.9.0",
  "description": "The contract of Foliwake core over HTTP: every procedure of /api/rpc with its kind, input and output types, the error codes, the API version and the contract digest. Generated from the engine's router.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.22" },
  "repository": { "type": "git", "url": "git+https://github.com/foliwake/foliwake-js.git", "directory": "packages/core-contract" },
  "homepage": "https://sdk.foliwake.dev/reference/packages/core-contract",
  "bugs": { "url": "https://github.com/foliwake/foliwake-js/issues" },
  "keywords": ["foliwake", "cms", "api", "contract", "trpc"],
  "publishConfig": { "access": "public", "provenance": true },
  "foliwake": { "coreApi": 1 },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "!dist/**/*.map", "LICENSE", "README.md", "CHANGELOG.md"]
}
