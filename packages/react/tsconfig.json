{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": true,
    "removeComments": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "newLine": "lf"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
