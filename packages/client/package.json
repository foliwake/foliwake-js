{
  "name": "@foliwake/client",
  "version": "0.5.0",
  "description": "Framework-free browser client for Foliwake pages: mountFoliwakePage mounts a page's blocks from its own code release into a DOM element (body, host, events, abort guards, block CSS). No framework dependency; the base of @foliwake/react and other adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/foliwake/foliwake-js.git", "directory": "packages/client" },
  "homepage": "https://sdk.foliwake.dev/reference/packages/client",
  "bugs": { "url": "https://github.com/foliwake/foliwake-js/issues" },
  "keywords": ["foliwake", "cms", "headless", "blocks", "browser", "dom", "client"],
  "engines": { "node": ">=22.22" },
  "publishConfig": { "access": "public", "provenance": true },
  "foliwake": { "plain": 2, "blocksContract": 2, "remoteConfig": 2 },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@foliwake/blocks-contract": "workspace:*"
  },
  "files": ["dist/", "!dist/**/*.map", "!dist/.build-stamp", "!dist/.build-manifest.json", "LICENSE", "README.md", "CHANGELOG.md"]
}
