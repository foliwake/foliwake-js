{
  "name": "@foliwake/blocks-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Types of the Foliwake blocks contract (foliwake-blocks/1) and the page types shared by @foliwake/server and @foliwake/react. No runtime code.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.22" },
  "repository": { "type": "git", "url": "git+https://github.com/adjioev/foliwake.git", "directory": "packages/blocks-contract" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "foliwake": { "plain": 2, "blocksContract": 1, "remoteConfig": 2 },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./page": { "types": "./dist/page.d.ts", "default": "./dist/page.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "!dist/**/*.map", "!dist/.build-stamp", "!dist/.build-manifest.json", "LICENSE", "README.md"]
}
