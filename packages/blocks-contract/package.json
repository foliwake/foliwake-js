{
  "name": "@foliwake/blocks-contract",
  "version": "0.5.0",
  "description": "Types of the Foliwake blocks contract (foliwake-blocks/2: the core, and the /assessment extension) and the page types shared by @foliwake/server and @foliwake/client; one browser-safe runtime helper, the import map of a code release (/import-map).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.22" },
  "repository": { "type": "git", "url": "git+https://github.com/foliwake/foliwake-js.git", "directory": "packages/blocks-contract" },
  "homepage": "https://sdk.foliwake.dev/reference/packages/blocks-contract",
  "bugs": { "url": "https://github.com/foliwake/foliwake-js/issues" },
  "keywords": ["foliwake", "cms", "headless", "blocks", "types", "typescript", "contract"],
  "publishConfig": { "access": "public", "provenance": true },
  "foliwake": { "plain": 2, "blocksContract": 2, "remoteConfig": 2 },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./assessment": { "types": "./dist/assessment.d.ts", "default": "./dist/assessment.js" },
    "./import-map": { "types": "./dist/import-map.d.ts", "default": "./dist/import-map.js" },
    "./page": { "types": "./dist/page.d.ts", "default": "./dist/page.js" },
    "./reserved": { "types": "./dist/reserved.d.ts", "default": "./dist/reserved.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "!dist/**/*.map", "!dist/.build-stamp", "!dist/.build-manifest.json", "LICENSE", "README.md", "CHANGELOG.md"]
}
